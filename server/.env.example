HOST=127.0.0.1
PORT=3001
OLLAMA_URL=http://127.0.0.1:11434
# Ollama en streaming : l'IA peut raisonner longtemps tant que des données arrivent.
# Ces délais concernent uniquement l'IA locale, en millisecondes.
OLLAMA_IDLE_TIMEOUT_MS=900000
OLLAMA_MAX_DURATION_MS=3600000
# Le planning JSON utilise think=false par défaut ; activer seulement pour des tests.
OLLAMA_PLANNING_THINK=false
# Garde-fou si Ollama ignore think=false et produit uniquement du raisonnement.
OLLAMA_MAX_THINKING_ONLY_MS=90000
# Fenêtre de contexte RÉSERVÉE, pas le nombre de tokens réellement envoyés.
# Augmenter peut consommer davantage de RAM/VRAM et ralentir le modèle.
OLLAMA_NUM_CTX=8192
# Limits for constrained JSON output; increase if a legitimate plan is truncated.
OLLAMA_PLAN_NUM_PREDICT=1500
OLLAMA_GEOMETRY_NUM_PREDICT=650
OLLAMA_REVIEW_NUM_PREDICT=900
# Ollama SERVER settings (set in Windows environment when starting Ollama, NOT Node):
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
TRACE_LEVEL=full
MCP_PROTOCOL_VERSION=2025-11-25
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
